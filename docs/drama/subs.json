{
  "ch01_s01": [[2.0, 4.5, "好好吃！"]],
  "ch01_s02": [[2.5, 5.5, "这片地盘交保护费了吗？"]],
  "ch01_s03": [],
  "ch01_s04": [[5.0, 8.5, "第一天，我赚到了一万块。"]],

  "ch02_s01": [[2.0, 5.5, "假千金也想开店？押金翻三倍。"]],
  "ch02_s02": [[3.0, 5.5, "这栋楼，你开个价。"]],
  "ch02_s03": [],
  "ch02_s04": [[5.5, 8.0, "缺人吗？"]],

  "ch03_s01": [[2.5, 5.0, "这种东西也敢卖？"]],
  "ch03_s02": [[2.0, 4.5, "晚晚，回来求我，"], [4.5, 7.5, "我还可以给你一个位置。"]],
  "ch03_s03": [[2.0, 5.5, "我们排了两个小时，你们算老几？"], [6.0, 7.5, "就是！"]],
  "ch03_s04": [[2.5, 5.5, "插队，按十倍收费。慢走不送。"]],

  "ch04_s01": [[3.0, 6.5, "那是外婆的方子。一个字都没改。"]],
  "ch04_s02": [[2.0, 4.0, "胜算三成。"], [4.5, 6.5, "那就三成。"]],
  "ch04_s03": [[2.0, 4.8, "这份配方的手稿，"], [4.8, 7.5, "比苏氏食品成立早了二十年。"]],
  "ch04_s04": [[1.0, 4.0, "被告苏氏食品构成侵权，"], [4.0, 7.5, "公开道歉，下架全部相关产品。"]],

  "ch05_s01": [[1.5, 4.0, "抱歉，今晚只接待"], [4.0, 6.5, "捐赠超过一千万的嘉宾。"]],
  "ch05_s02": [[1.5, 4.5, "今晚最大的捐赠人是"], [4.5, 7.5, "晚星甜品创始人，苏晚女士。"]],
  "ch05_s03": [[0.3, 3.0, "这个位置，本来就该是我的。"]],
  "ch05_s04": [[4.0, 6.5, "疼就抓着我。"]],

  "ch06_s01": [[2.0, 5.0, "跌停了！第三个跌停了！"]],
  "ch06_s02": [[1.0, 7.5, "14:00 → 17:00"]],
  "ch06_s03": [[1.5, 5.0, "晚晚，我们好歹养了你二十年……"], [6.5, 9.5, "签了它，苏家还能留个名字。"]],
  "ch06_s04": [[3.0, 5.0, "晚晚，我错了。"], [5.0, 7.5, "我们重新开始好不好？"]],

  "ch07_s01": [[1.5, 5.0, "苏小姐，一个月，我就能挤垮你。"], [6.0, 8.0, "霍总可以试试。"]],
  "ch07_s02": [[2.0, 4.8, "晚晚，你不是谁家多出来的孩子。"], [4.8, 8.0, "你是沈家的小星星。"]],
  "ch07_s03": [[1.5, 3.5, "你到底是谁？"], [5.0, 7.5, "你是沈家唯一的外孙女。"], [7.5, 10.0, "我找了你很多年。"]],
  "ch07_s04": [],

  "ch08_s01": [[1.0, 5.0, "晚星集团 · 年度发布会"]],
  "ch08_s02": [[2.0, 5.5, "苏小姐，当年调包的事你知情吗？"]],
  "ch08_s03": [[1.5, 4.0, "三年前，所有人都在笑我。"], [4.0, 6.5, "现在，他们排队等我回头。"], [6.5, 9.0, "可我不会回头了。"]],
  "ch08_s04": [[3.0, 5.0, "回家吗？"], [6.0, 8.0, "嗯，回家。"]]
}
